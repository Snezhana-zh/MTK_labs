import string;
import description;
import vmnemo;

export {

VarDefArToStr(vdl : VarDefinitionArray) -> string;

rvalueExprToStr(e : RvalueExpr) -> string;

printBody(body : Body) -> string {
    switch (body) {
        Assignment(v, e) : v + " := " + rvalueExprToStr(e);
        Sequence(bs) : fold(bs, "", \acc, b -> acc + printBody(b) + "\n");
        UBodies(bs) : fold(bs, "", \acc, b -> acc + printBody(b));
        Iteration(b) : "{" + printBody(b) + "}*";
        Test(e) : boolExprToStr(e);
        Print(e) : "print(" + rvalueExprToStr(e) + ")";
        ArrayUpdate(arr, i, v) : "upd(" + rvalueExprToStr(arr) + ", " + rvalueExprToStr(i) + ", " + rvalueExprToStr(v) + ")";
    }
}

typeToStr(t : Types) -> string {
    switch (t) {
        IntType() : "int";
        ArrayType(Type) : "[" + typeToStr(Type) + "]";
    }
}

varDefToStr(v: VarDefinition) -> string {
    "var " + v.name + " : " + typeToStr(v.type) + ";";
}

VarDefArToStr(vd : VarDefinitionArray) -> string {
    fold(vd.elems, "", \s, d -> {
        s + varDefToStr(d) + "\n";
    })
}

ExpToStr(e : NumExpr, wasMul : bool) -> string {
    switch(e) {
        Sum(e1, e2): {
            if (wasMul) {
                "(" + ExpToStr(e1, false) + " + " + ExpToStr(e2, false) + ")";
            }
            else {
                ExpToStr(e1, false) + " + " + ExpToStr(e2, false);
            }
        }
        Sub(e1, e2): {
            if (wasMul) {
                "(" + ExpToStr(e1, false) + " + " + ExpToStr(e2, false) + ")";
            }
            else {
                ExpToStr(e1, false) + " + " + ExpToStr(e2, false);
            }
        }
        Mul(e1, e2): ExpToStr(e1, true) + " * " + ExpToStr(e2, true);
        Div(e1, e2): ExpToStr(e1, true) + " / " + ExpToStr(e2, true);
        IntConst(i): i2s(i);
        Var(name): name;
        MinusVar(e1): "-" + ExpToStr(e1, wasMul);
    }
}

boolExprToStr(e : BoolExpr) -> string {
    switch (e) {
        Equal(l, r) : rvalueExprToStr(l) + "=" + rvalueExprToStr(r);
        Less(l, r) : rvalueExprToStr(l) + "<" + rvalueExprToStr(r);
        Not(ex) : "not(" + boolExprToStr(ex) + ")";
        Or(l, r) : "(" + boolExprToStr(l) + ")" + " || " + "(" + boolExprToStr(r) + ")";
        And(l, r) : "(" + boolExprToStr(l) + ")" + " && " + "(" + boolExprToStr(r) + ")";
    }
}

rvalueExprToStr(e : RvalueExpr) -> string {
    switch (e) {
        Var(name) : name;
        IntConst(c) : i2s(c);
        NumExpr() : ExpToStr(e, false);
        ArrayApply(arr, index) : "app(" + rvalueExprToStr(arr) + ", " + rvalueExprToStr(index) + ")";
        BoolExpr() : boolExprToStr(e);
        Array(a) : "array";
    }
}

